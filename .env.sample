# Credentials for authentication with Osnabrück University's website.
UOS_MCP_USERNAME="user"
UOS_MCP_PASSWORD="secret"

# Set to `true` to skip authentication and access only public content.
# UOS_MCP_SKIP_LOGIN="true"

# Custom User-Agent header sent to the university website.
# UOS_MCP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# If set, the server runs on HTTP transport instead of stdio.
# UOS_MCP_SERVER_PORT="8080"
# UOS_MCP_SERVER_HOST="127.0.0.1"

# Path to the pre-scraped people-directory JSON file used to answer
# uos_people_search (produced by `mcp-uos-scrape-people`). Required for
# the server to start; defaults to ./data/people.json.
# UOS_MCP_PEOPLE_DATA_PATH="./data/people.json"
